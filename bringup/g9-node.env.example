# Environment for one G9XC node worker. Copy to /etc/g9-node/<unit_id>.env and
# edit. Read by bringup/g9-node@.service as EnvironmentFile.
#
# This file is per-unit on purpose: the unit_id is what the coordinator, the
# deployment config and the inventory all agree on, and a node that lies about
# its identity is a node whose shards go to the wrong console.

# Where the portable core lives on this node (a ram-coffers checkout). Repeated
# as PYTHONPATH because systemd does not expand variables in WorkingDirectory,
# and the worker is started as `python3 -m gen9_cluster`.
G9_CLUSTER=/opt/ram-coffers/gen9-cluster
PYTHONPATH=/opt/ram-coffers/gen9-cluster

# The deployment config produced by `gen_fleet_config.py --plan`. Distributed to
# every node; each node reads only its own section.
G9_CONFIG=/etc/g9-node/deployment.json

# Interface to listen on. 0.0.0.0 is right on an isolated compute VLAN and
# wrong on anything else: G9XC has no authentication whatsoever (see
# docs/G9XC_CONTRACT.md), so reachability is the entire security model.
G9_HOST=0.0.0.0

# 0 means "use the port from the deployment config", which is what the
# coordinator will actually dial. Override only when debugging.
G9_PORT=0

# Leave empty to use the backend from the deployment config. Set to cpu-avx2 to
# force the CPU path when a GPU stack is broken on this unit, which is a
# perfectly reasonable temporary state — the node keeps holding its shards, just
# more slowly.
#G9_BACKEND=cpu-avx2
